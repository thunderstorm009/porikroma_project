# Porikroma FastAPI Environment Configuration
# Copy this file to .env and adjust values for your local environment

# PostgreSQL connection string
DATABASE_URL=postgres://postgres@localhost:5432/porikroma

# JWT secret key for access tokens and password reset signatures (minimum 16 characters)
JWT_SECRET=replace-with-a-long-random-secret-for-jwt-signing

# Server port (default: 4000)
PORT=4000

# CORS origins: comma-separated URLs or '*' to allow all origins
CORS_ORIGINS=*
